# Copia este archivo como .env.local y pon tus valores.
# Los encuentras en Supabase → Project Settings → API.
#
# La clave anónima es PÚBLICA por diseño: viaja en el JavaScript que
# descarga cualquier visitante. No es un secreto y no pasa nada si
# alguien la ve. Lo que nunca debe salir del panel de Supabase es la
# clave "service_role": esa sí lo abre todo.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
